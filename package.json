{
  "name": "nfe-emitter",
  "version": "2.0.0",
  "description": "Emissão de NF-e, controle de estoque e tributação automática com geração de EFD",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "node scripts/reset-db.js"
  },
  "keywords": [
    "nfe",
    "nota-fiscal",
    "sefaz",
    "xml",
    "assinatura-digital"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sequelize": "^6.35.0",
    "pg": "^8.11.0",
    "axios": "^1.6.0",
    "xml2js": "^0.6.2",
    "js2xmlparser": "^5.0.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express-validator": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1",
    "node-forge": "^1.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.2",
    "eslint": "^8.51.0"
  }
}
