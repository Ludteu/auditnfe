# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nfe_emitter
DB_USER=postgres
DB_PASSWORD=sua_senha

# Server
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# JWT
JWT_SECRET=sua_chave_secreta_super_segura
JWT_EXPIRE=7d

# SEFAZ
SEFAZ_ENV=homologacao
SEFAZ_UF=SP
SEFAZ_TIMEOUT=30000

# Certificado digital: a senha agora é enviada no upload de cada certificado
# (tela "Minha empresa") e guardada criptografada no banco usando JWT_SECRET
# como chave — não precisa mais de variável de ambiente pra isso.

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Marketplace — Mercado Livre (crie um app em developers.mercadolivre.com.br)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=http://localhost:5000/api/marketplace/mercado-livre/callback

# Email (opcional, para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_app
